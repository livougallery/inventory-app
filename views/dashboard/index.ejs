<h1 class="text-2xl font-bold mb-4">Dashboard</h1>
<p class="text-gray-600 mb-6">Selamat datang, <strong><%= user.nama_lengkap %></strong>!</p>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="bg-white shadow rounded p-4">
    <p class="text-sm text-gray-500">🧵 Stok Bahan Baku</p>
    <p class="text-2xl font-bold"><%= Number(stokBahan).toLocaleString('id-ID') %></p>
    <p class="text-xs text-gray-400"><%= totalBahan %> jenis bahan</p>
  </div>
  <div class="bg-white shadow rounded p-4">
    <p class="text-sm text-gray-500">🏭 Produksi Berjalan</p>
    <p class="text-2xl font-bold"><%= produksiBerjalan %></p>
    <p class="text-xs text-gray-400">batch aktif</p>
  </div>
  <div class="bg-white shadow rounded p-4">
    <p class="text-sm text-gray-500">⏳ Pending Validasi</p>
    <p class="text-2xl font-bold"><%= totalPending %></p>
    <p class="text-xs text-gray-400">menunggu Finance</p>
  </div>
</div>

<% if (bahanMenipis.length > 0) { %>
<div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6 rounded">
  <strong class="text-yellow-800">⚠️ Stok Menipis!</strong>
  <ul class="mt-1 text-sm">
    <% bahanMenipis.forEach(b => { %>
    <li>• <%= b.nama %> — <%= b.stok %> <%= b.satuan %> (min: <%= b.stok_minimum %>)</li>
    <% }) %>
  </ul>
</div>
<% } %>

<% if (products.length > 0) { %>
<div class="bg-white shadow rounded p-4 mb-6">
  <h3 class="font-bold mb-3">📈 Rata-rata HPP per Produk</h3>
  <div class="space-y-3">
    <% var maxHpp = Math.max(...products.map(p => p.avg_hpp), 1); %>
    <% products.forEach(p => { %>
    <div>
      <div class="flex justify-between text-sm mb-1">
        <span><%= p.nama_produk %></span>
        <span class="font-semibold">Rp <%= Number(p.avg_hpp).toLocaleString('id-ID') %></span>
      </div>
      <div class="bg-gray-200 rounded h-4 w-full">
        <div class="bg-blue-500 h-4 rounded" style="width: <%= (p.avg_hpp / maxHpp * 100) %>%"></div>
      </div>
    </div>
    <% }) %>
  </div>
</div>
<% } %>

<% if (user.role === 'finance' && totalPending > 0) { %>
<div class="bg-blue-50 border border-blue-200 p-4 rounded">
  <strong>🔔 Validasi Pending</strong>
  <p class="text-sm mt-1"><%= totalPending %> transaksi menunggu validasi.
  <a href="/validation" class="text-blue-600 hover:underline">Lihat Semua →</a></p>
</div>
<% } %>
