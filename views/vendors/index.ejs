<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">Data Vendor</h1>
  <% if (user.role === 'admin') { %>
    <a href="/vendors/create" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">+ Tambah</a>
  <% } %>
</div>
<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Nama</th>
      <th class="p-3 text-left">Tipe</th>
      <th class="p-3 text-left">Kontak</th>
      <% if (user.role === 'admin') { %><th class="p-3 text-left">Aksi</th><% } %>
    </tr></thead>
    <tbody>
      <% vendors.forEach(v => { %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-3 font-medium"><%= v.nama %></td>
        <td class="p-3">
          <span class="px-2 py-0.5 text-xs rounded-full
            <%= v.tipe === 'bahan_baku' ? 'bg-blue-100 text-blue-700' : '' %>
            <%= v.tipe === 'produksi' ? 'bg-green-100 text-green-700' : '' %>
            <%= v.tipe === 'import' ? 'bg-purple-100 text-purple-700' : '' %>">
            <%= v.tipe === 'bahan_baku' ? 'Bahan Baku' : v.tipe === 'produksi' ? 'Produksi' : 'Import' %>
          </span>
        </td>
        <td class="p-3"><%= v.kontak || '-' %></td>
        <% if (user.role === 'admin') { %>
        <td class="p-3">
          <a href="/vendors/<%= v.id %>/edit" class="text-blue-600 hover:underline mr-2">Edit</a>
          <form method="POST" action="/vendors/<%= v.id %>?_method=DELETE" style="display:inline"
                onsubmit="return confirm('Hapus <%= v.nama %>?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="text-red-600 hover:underline">Hapus</button>
          </form>
        </td>
        <% } %>
      </tr>
      <% }) %>
      <% if (vendors.length === 0) { %><tr><td colspan="4" class="p-3 text-center text-gray-400">Belum ada vendor</td></tr><% } %>
    </tbody>
  </table>
</div>
