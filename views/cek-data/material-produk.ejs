<%
  // Data dikirim ke TanStack Table (client-side) sebagai JSON.
  // View-only: halaman ini hanya untuk mengecek salah input data.
%>
<link rel="stylesheet" href="/cek-data.css">

<div class="cd-page">
  <h1 class="cd-title">📋 Material — Material Produk</h1>
  <p class="cd-subtitle">Kebutuhan bahan per varian produk dari Supabase — hanya untuk melihat, cek apakah ada salah input data</p>

  <%- include('_table', { cdTab: 'material-produk', cdP: 'cdb', cdPh: 'Cari produk / varian / bahan…' }) %>
</div>

<script src="/vendor/tanstack-table.js"></script>
<script src="/cek-data.js"></script>
<script id="cdb-data" type="application/json"><%- JSON.stringify(rows) %></script>
<script>
(function () {
  // qty dari pg bisa datang sebagai string — ubah ke number supaya sorting benar
  var toNum = function (v) { return v == null ? null : Number(v); };
  var data = JSON.parse(document.getElementById('cdb-data').textContent).map(function (r) {
    return Object.assign({}, r, { qty_per_pcs: toNum(r.qty_per_pcs) });
  });

  CekDataTable({
    prefix: 'cdb',
    data: data,
    rowId: function (r) { return r.id; },
    pageSize: 10,
    flag: function (r) { return Number(r.qty_per_pcs) <= 0; },
    columns: [
      { id: 'nama_produk', header: 'Produk' },
      { id: 'sku',         header: 'Varian (SKU)' },
      { id: 'bahan',       header: 'Bahan' },
      { id: 'qty_per_pcs', header: 'Qty per Pcs', type: 'num',
        cellClass: function (r) { return Number(r.qty_per_pcs) <= 0 ? 'cd-bad' : ''; } },
      { id: 'satuan',      header: 'Satuan' },
      { id: 'catatan',     header: 'Catatan' }
    ]
  });
})();
</script>
