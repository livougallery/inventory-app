<h1 class="text-2xl font-bold mb-4">📋 Kartu Stok Bahan Baku</h1>

<form method="GET" class="mb-4 bg-white shadow rounded p-4 flex gap-2">
  <select name="raw_material_id" class="border rounded p-2 flex-1" onchange="this.form.submit()">
    <option value="">-- Pilih Bahan --</option>
    <% materials.forEach(m => { %>
    <option value="<%= m.id %>" <%= selectedMaterial && selectedMaterial.id === m.id ? 'selected' : '' %>>
      <%= m.nama %> (<%= m.tipe === 'kain_roll' ? 'Roll' : m.tipe === 'kain_ecer' ? 'Ecer' : 'Aksesoris' %>) — Stok: <%= Number(m.stok).toLocaleString('id-ID') %> <%= m.satuan %>
    </option>
    <% }) %>
  </select>
</form>

<% if (selectedMaterial) { %>
<h2 class="font-bold mb-2"><%= selectedMaterial.nama %></h2>
<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Tanggal</th>
      <th class="p-3 text-left">Tipe</th>
      <th class="p-3 text-right">Masuk</th>
      <th class="p-3 text-right">Keluar</th>
      <th class="p-3 text-right">Saldo</th>
      <th class="p-3 text-left">Referensi</th>
    </tr></thead>
    <tbody>
      <% movements.forEach(m => { %>
      <tr class="border-t">
        <td class="p-3"><%= m.tanggal %></td>
        <td class="p-3"><%= m.tipe %></td>
        <td class="p-3 text-right"><%= m.masuk > 0 ? Number(m.masuk).toLocaleString('id-ID') : '-' %></td>
        <td class="p-3 text-right"><%= m.keluar > 0 ? Number(m.keluar).toLocaleString('id-ID') : '-' %></td>
        <td class="p-3 text-right font-bold"><%= Number(m.saldo).toLocaleString('id-ID') %></td>
        <td class="p-3"><%= m.ref %></td>
      </tr>
      <% }) %>
      <% if (movements.length === 0) { %><tr><td colspan="6" class="p-3 text-center text-gray-400">Tidak ada pergerakan stok</td></tr><% } %>
    </tbody>
  </table>
</div>
<% } %>
