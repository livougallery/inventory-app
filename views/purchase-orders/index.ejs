<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">Pembelian Bahan Baku</h1>
  <% if (user.role === 'admin') { %>
    <a href="/purchase-orders/create" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">+ Buat PO</a>
  <% } %>
</div>
<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">No. PO</th>
      <th class="p-3 text-left">Vendor</th>
      <th class="p-3 text-left">Tanggal</th>
      <th class="p-3 text-right">Total</th>
      <th class="p-3 text-left">Status</th>
      <th class="p-3 text-left">Dibuat Oleh</th>
      <th class="p-3 text-left">Aksi</th>
    </tr></thead>
    <tbody>
      <% orders.forEach(o => { %>
      <%
        const threeDaysMs = 3 * 24 * 60 * 60 * 1000;
        const isUrgent = o.status === 'pending' && (Date.now() - new Date(o.created_at).getTime() > threeDaysMs);
      %>
      <tr class="border-t hover:bg-gray-50 <%= isUrgent ? 'urgent-row' : '' %>">
        <td class="p-3 font-mono"><%= o.no_po %></td>
        <td class="p-3"><%= o.vendor_nama %></td>
        <td class="p-3"><%= o.tgl_beli %></td>
        <td class="p-3 text-right">Rp <%= Number(o.total || 0).toLocaleString('id-ID') %></td>
        <td class="p-3">
          <span class="px-2 py-0.5 text-xs rounded-full
            <%= o.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : '' %>
            <%= o.status === 'validated' ? 'bg-green-100 text-green-700' : '' %>
            <%= o.status === 'rejected' ? 'bg-red-100 text-red-700' : '' %>
            <%= o.status === 'received' ? 'bg-blue-100 text-blue-700' : '' %>">
            <%= o.status === 'pending' ? 'Pending' : o.status === 'validated' ? 'Tervalidasi' : o.status === 'rejected' ? 'Ditolak' : 'Diterima' %>
          </span>
        </td>
        <td class="p-3"><%= o.creator_name %></td>
        <td class="p-3"><a href="/purchase-orders/<%= o.id %>" class="text-blue-600 hover:underline">Detail</a></td>
      </tr>
      <% }) %>
      <% if (orders.length === 0) { %><tr><td colspan="7" class="p-3 text-center text-gray-400">Belum ada PO</td></tr><% } %>
    </tbody>
  </table>
</div>
