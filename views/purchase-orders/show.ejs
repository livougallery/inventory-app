<div class="mb-4">
  <a href="/purchase-orders" class="text-blue-600 hover:underline text-sm"><i data-lucide="arrow-left"></i> Kembali</a>
</div>
<div class="page-header">
  <h1 class="page-title">Detail PO: <%= po.no_po %></h1>
  <% if (po.status === 'pending') { %>
    <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('quick-edit-modal').classList.remove('hidden')">
      <i data-lucide="pencil"></i> Quick Edit
    </button>
  <% } %>
</div>
<div class="bg-white shadow rounded p-4 mb-4 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
  <div><span class="text-gray-500">Vendor:</span> <strong><%= po.vendor_nama %></strong></div>
  <div><span class="text-gray-500">Tanggal:</span> <strong><%= po.tgl_beli %></strong></div>
  <div>
    <span class="text-gray-500">Status:</span>
    <span class="px-2 py-0.5 text-xs rounded-full
      <%= po.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : '' %>
      <%= po.status === 'validated' ? 'bg-green-100 text-green-700' : '' %>
      <%= po.status === 'rejected' ? 'bg-red-100 text-red-700' : '' %>">
      <%= po.status %>
    </span>
  </div>
  <div><span class="text-gray-500">Dibuat:</span> <strong><%= po.creator_name %></strong></div>
</div>

<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Item</th>
      <th class="p-3 text-right">Qty</th>
      <th class="p-3 text-right">Harga Satuan</th>
      <th class="p-3 text-right">Subtotal</th>
    </tr></thead>
    <tbody>
      <% var grandTotal = 0; %>
      <% po.items.forEach(i => { %>
      <tr class="border-t">
        <td class="p-3"><%= i.material_nama %></td>
        <td class="p-3 text-right"><%= Number(i.qty).toLocaleString('id-ID') %> <%= i.satuan %></td>
        <td class="p-3 text-right">Rp <%= Number(i.harga_satuan).toLocaleString('id-ID') %></td>
        <td class="p-3 text-right">Rp <%= Number(i.subtotal).toLocaleString('id-ID') %></td>
      </tr>
      <% grandTotal += i.subtotal; %>
      <% }) %>
      <tr class="border-t font-bold">
        <td colspan="3" class="p-3 text-right">Total</td>
        <td class="p-3 text-right">Rp <%= Number(grandTotal).toLocaleString('id-ID') %></td>
      </tr>
    </tbody>
  </table>
</div>

<% if (po.status === 'rejected' && po.catatan_reject) { %>
<div class="bg-red-50 border border-red-200 p-4 mt-4 rounded">
  <strong>Alasan ditolak:</strong> <%= po.catatan_reject %>
</div>
<% } %>

<% if (po.status === 'pending') { %>
<div id="quick-edit-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center" style="background-color:rgba(0,0,0,0.5);">
  <div class="card max-w-md w-full">
    <div class="card-header flex justify-between items-center">
      <span class="font-semibold">Quick Edit PO</span>
      <button type="button" onclick="document.getElementById('quick-edit-modal').classList.add('hidden')" style="background:transparent;border:none;color:#9ca3af;font-size:1.25rem;cursor:pointer;line-height:1;"><i data-lucide="x"></i></button>
    </div>
    <div class="card-body">
      <form id="quick-edit-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="input-label">No. PO</label>
        <input class="input-field mb-3" name="no_po" value="<%= po.no_po %>" required style="margin-bottom:0.75rem;">
        <label class="input-label">Catatan</label>
        <textarea class="input-field" name="catatan" rows="3" style="margin-bottom:0.75rem;"><%= po.catatan_reject || '' %></textarea>
        <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
          <button type="button" class="btn btn-ghost" onclick="document.getElementById('quick-edit-modal').classList.add('hidden')">Batal</button>
          <button type="submit" class="btn btn-primary">Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('quick-edit-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const fd = new FormData(e.target);
  const r = await fetch('/purchase-orders/<%= po.id %>/quick-edit', { method: 'POST', body: fd });
  const j = await r.json();
  if (j.ok) {
    document.getElementById('quick-edit-modal').classList.add('hidden');
    location.reload();
  } else {
    alert('Gagal: ' + j.error);
  }
});
</script>
<% } %>
