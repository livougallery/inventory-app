<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Inventory System' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .sidebar-link { @apply block px-4 py-2 text-sm hover:bg-gray-700 rounded; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex">
  <% if (locals.user) { %>
  <aside class="no-print w-64 bg-gray-800 text-white flex-shrink-0 hidden md:block min-h-screen">
    <div class="p-4 font-bold text-lg border-b border-gray-700">📦 Inventory</div>
    <div class="px-4 py-2 text-xs text-gray-400 border-b border-gray-700"><%= user.nama_lengkap %> (<%= user.role === 'admin' ? 'Admin' : 'Finance' %>)</div>
    <nav class="p-2 space-y-0.5">
      <a href="/dashboard" class="sidebar-link"><%= currentPath === '/dashboard' ? '▶' : ' ' %> 📊 Dashboard</a>
      <div class="text-[10px] text-gray-500 px-4 pt-3 pb-0.5 uppercase tracking-wider">Master Data</div>
      <a href="/vendors" class="sidebar-link"><%= currentPath.startsWith('/vendors') ? '▶' : ' ' %> 🏢 Vendor</a>
      <a href="/products" class="sidebar-link"><%= currentPath.startsWith('/products') ? '▶' : ' ' %> 📦 Produk</a>
      <a href="/raw-materials" class="sidebar-link"><%= currentPath.startsWith('/raw-materials') ? '▶' : ' ' %> 🧵 Bahan Baku</a>
      <div class="text-[10px] text-gray-500 px-4 pt-3 pb-0.5 uppercase tracking-wider">Transaksi</div>
      <a href="/purchase-orders" class="sidebar-link"><%= currentPath.startsWith('/purchase-orders') ? '▶' : ' ' %> 🛒 Pembelian Bahan</a>
      <a href="/production-batches" class="sidebar-link"><%= currentPath.startsWith('/production-batches') ? '▶' : ' ' %> 🏭 Produksi</a>
      <a href="/purchase-imports" class="sidebar-link"><%= currentPath.startsWith('/purchase-imports') ? '▶' : ' ' %> 📥 Beli Jadi</a>
      <div class="text-[10px] text-gray-500 px-4 pt-3 pb-0.5 uppercase tracking-wider">Analisa</div>
      <a href="/hpp" class="sidebar-link"><%= currentPath.startsWith('/hpp') ? '▶' : ' ' %> 💰 HPP</a>
      <% if (user.role === 'finance') { %>
      <div class="text-[10px] text-gray-500 px-4 pt-3 pb-0.5 uppercase tracking-wider">Validasi</div>
      <a href="/validation" class="sidebar-link"><%= currentPath.startsWith('/validation') ? '▶' : ' ' %> ✅ Validasi Finance</a>
      <% } %>
      <div class="text-[10px] text-gray-500 px-4 pt-3 pb-0.5 uppercase tracking-wider">Laporan</div>
      <a href="/reports/stock-card" class="sidebar-link">📋 Kartu Stok</a>
      <a href="/reports/monthly-expenses" class="sidebar-link">📉 Pengeluaran</a>
    </nav>
    <div class="p-4 border-t border-gray-700 mt-auto">
      <a href="/logout" class="text-sm text-gray-400 hover:text-white">🚪 Logout</a>
    </div>
  </aside>

  <!-- mobile bottom nav -->
  <nav class="no-print md:hidden fixed bottom-0 left-0 right-0 bg-gray-800 text-white flex justify-around py-2 z-10 text-xs">
    <a href="/dashboard" class="text-center">📊</a>
    <a href="/vendors" class="text-center">🏢</a>
    <a href="/products" class="text-center">📦</a>
    <a href="/purchase-orders" class="text-center">🛒</a>
    <a href="/production-batches" class="text-center">🏭</a>
  </nav>
  <% } %>

  <main class="flex-1 p-4 md:p-6 pb-20 md:pb-6 min-h-screen w-full max-w-7xl mx-auto">
    <% if (locals.success) { %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 text-sm"><%= success %></div>
    <% } %>
    <% if (locals.error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm"><%= error %></div>
    <% } %>
    <%- body %>
  </main>
</body>
</html>
