<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Inventory System' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .sidebar-link { display:flex; align-items:center; gap:0.75rem; padding:0.625rem 1rem; font-size:0.875rem; border-radius:0.5rem; transition:all 200ms; text-decoration:none; }
    .sidebar-link:not(.active) { color:#d1d5db; }
    .sidebar-link:not(.active):hover { background-color:#1f2937; color:#fff; }
    .sidebar-link.active { background-color:#4f46e5; color:#fff; box-shadow:0 10px 25px -5px rgb(79 70 229 / 0.2); }
    .sidebar-group { font-size:10px; color:#6b7280; padding:0 1rem 0.375rem; text-transform:uppercase; letter-spacing:0.1em; font-weight:600; }
    .sidebar-group:not(:first-of-type) { border-top:0.5px solid rgb(31 41 55 / 0.5); padding-top:1.25rem; margin-top:0.5rem; }

    .card { background:#fff; border-radius:0.75rem; box-shadow:0 1px 2px 0 rgba(0,0,0,0.04); border:1px solid #f3f4f6; }
    .card-header { padding:1rem 1.5rem; border-bottom:1px solid #f3f4f6; }
    .card-body { padding:1.5rem; }

    .stat-card { background:#fff; border-radius:0.75rem; box-shadow:0 1px 2px 0 rgba(0,0,0,0.04); border:1px solid #f3f4f6; padding:1.25rem; transition:all 200ms; }
    .stat-card:hover { box-shadow:0 4px 12px 0 rgba(0,0,0,0.08); border-color:#e0e7ff; }

    .table-container { background:#fff; border-radius:0.75rem; box-shadow:0 1px 2px 0 rgba(0,0,0,0.04); border:1px solid #f3f4f6; overflow-x:auto; }
    .table-container table { width:100%; font-size:0.875rem; border-collapse:collapse; }
    .table-container thead { background:#f9fafb; }
    .table-container th { padding:0.875rem 1rem; text-align:left; font-size:0.75rem; font-weight:600; color:#6b7280; text-transform:uppercase; letter-spacing:0.05em; }
    .table-container td { padding:0.875rem 1rem; font-size:0.875rem; color:#374151; }
    .table-container tbody tr { border-top:1px solid #f3f4f6; transition:background-color 150ms; }
    .table-container tbody tr:hover { background:#f9fafb; }
    .table-container tbody tr:last-child td:first-child { border-bottom-left-radius:0.75rem; }
    .table-container tbody tr:last-child td:last-child { border-bottom-right-radius:0.75rem; }

    .badge { display:inline-flex; align-items:center; gap:0.25rem; padding:0.125rem 0.625rem; font-size:0.75rem; font-weight:500; border-radius:9999px; }

    .input-field { width:100%; border:1px solid #e5e7eb; border-radius:0.5rem; padding:0.625rem 0.875rem; font-size:0.875rem; transition:all 200ms; outline:none; }
    .input-field:focus { border-color:#818cf8; box-shadow:0 0 0 2px #e0e7ff; }
    .input-field::placeholder { color:#9ca3af; }
    .input-label { display:block; font-size:0.875rem; font-weight:500; color:#374151; margin-bottom:0.375rem; }

    .btn { display:inline-flex; align-items:center; justify-content:center; gap:0.5rem; padding:0.625rem 1rem; font-size:0.875rem; font-weight:500; border-radius:0.5rem; transition:all 200ms; text-decoration:none; border:none; cursor:pointer; outline:none; }
    .btn:focus { box-shadow:0 0 0 2px #fff, 0 0 0 4px #818cf8; }
    .btn-primary { background:#4f46e5; color:#fff; box-shadow:0 1px 2px 0 rgba(0,0,0,0.05); }
    .btn-primary:hover { background:#4338ca; box-shadow:0 1px 3px 0 rgba(0,0,0,0.1); }
    .btn-success { background:#059669; color:#fff; box-shadow:0 1px 2px 0 rgba(0,0,0,0.05); }
    .btn-success:hover { background:#047857; box-shadow:0 1px 3px 0 rgba(0,0,0,0.1); }
    .btn-danger { background:#ef4444; color:#fff; box-shadow:0 1px 2px 0 rgba(0,0,0,0.05); }
    .btn-danger:hover { background:#dc2626; box-shadow:0 1px 3px 0 rgba(0,0,0,0.1); }
    .btn-ghost { color:#4b5563; }
    .btn-ghost:hover { background:#f3f4f6; }
    .btn-sm { padding:0.375rem 0.75rem; font-size:0.75rem; }

    .alert { display:flex; align-items:flex-start; gap:0.75rem; padding:0.875rem 1rem; border-radius:0.5rem; font-size:0.875rem; }
    .alert-warning { background:#fffbeb; border:1px solid #fde68a; color:#92400e; }
    .alert-info { background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; }
    .alert-success { background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46; }
    .alert-error { background:#fef2f2; border:1px solid #fecaca; color:#991b1b; }

    .progress-bar { background:#f3f4f6; border-radius:9999px; height:0.625rem; overflow:hidden; }
    .progress-fill { height:100%; border-radius:9999px; transition:all 500ms; }

    .form-card { background:#fff; border:1px solid #f3f4f6; border-radius:0.75rem; box-shadow:0 1px 2px 0 rgba(0,0,0,0.04); padding:1.5rem; max-width:42rem; }
    .form-card.max-w-xl, .form-card.max-w-2xl, .form-card.max-w-3xl { max-width:none; }
    .form-section { margin-bottom:1.5rem; }
    .form-grid { display:grid; grid-template-columns:1fr; gap:1rem; margin-bottom:1.5rem; }
    @media (min-width:640px){ .form-grid { grid-template-columns:1fr 1fr; } }

    .page-header { display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1.5rem; }
    @media (min-width:640px){ .page-header { flex-direction:row; align-items:center; justify-content:space-between; } }
    .page-title { font-size:1.25rem; font-weight:700; color:#111827; }
    @media (min-width:640px){ .page-title { font-size:1.5rem; } }

    @media print { .no-print { display: none !important; } }

    /* Scrollbar styling */
    .sidebar-scroll::-webkit-scrollbar { width: 4px; }
    .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
    .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }
    .sidebar-scroll::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

    /* Added for #9 + alert-urgent #7 */
    .urgent-row { background:#fef3c7 !important; }
    .urgent-row-critical { background:#fee2e2 !important; }
    .dismiss-banner { float:right; background:transparent; border:none; color:inherit; cursor:pointer; font-size:1.25rem; line-height:1; }

    /* ===== Sidebar fun (gradient, bisa di-collapse) ===== */
    .sidebar-aside { width:15rem; flex-shrink:0; min-height:100vh; background:linear-gradient(180deg,#6d28d9 0%,#a21caf 55%,#db2777 100%); color:#fff; transition:width 220ms ease; }
    .sidebar-aside.collapsed { width:4.5rem; }
    .sb-header { display:flex; align-items:center; justify-content:space-between; gap:0.5rem; padding:0.9rem 0.85rem; border-bottom:1px solid rgba(255,255,255,0.18); }
    .sb-brand { display:flex; align-items:center; gap:0.5rem; font-weight:800; font-size:1.05rem; white-space:nowrap; overflow:hidden; }
    .sb-logo { font-size:1.3rem; }
    .sb-toggle { background:rgba(255,255,255,0.18); border:none; color:#fff; width:1.9rem; height:1.9rem; border-radius:9999px; cursor:pointer; font-size:0.8rem; line-height:1; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background 150ms, transform 150ms; }
    .sb-toggle:hover { background:rgba(255,255,255,0.35); transform:scale(1.08); }
    .sb-user { padding:0.55rem 0.85rem; font-size:0.72rem; background:rgba(255,255,255,0.12); border-radius:0.6rem; margin:0.6rem 0.75rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sb-nav { padding:0.5rem 0.75rem; display:flex; flex-direction:column; gap:0.35rem; }
    .sb-group { font-size:9px; color:rgba(255,255,255,0.55); padding:0.9rem 0.5rem 0.2rem; text-transform:uppercase; letter-spacing:0.12em; font-weight:700; }
    .sb-item { display:flex; align-items:center; gap:0.7rem; padding:0.6rem 0.75rem; border-radius:0.7rem; color:rgba(255,255,255,0.88); text-decoration:none; font-size:0.875rem; font-weight:600; transition:all 180ms; white-space:nowrap; overflow:hidden; }
    .sb-item:hover { background:rgba(255,255,255,0.16); color:#fff; transform:translateX(2px); }
    .sb-item.active { background:rgba(255,255,255,0.94); color:#a21caf; box-shadow:0 8px 20px -6px rgba(255,255,255,0.45); }
    .sb-icon { width:1.6rem; text-align:center; font-size:1.05rem; flex-shrink:0; }
    .sb-footer { margin-top:auto; padding:0.75rem; border-top:1px solid rgba(255,255,255,0.18); }
    .sidebar-aside.collapsed .sb-label, .sidebar-aside.collapsed .sb-user { display:none; }
    .sidebar-aside.collapsed .sb-header { justify-content:center; padding-left:0.4rem; padding-right:0.4rem; }
    .sidebar-aside.collapsed .sb-item { justify-content:center; padding-left:0.4rem; padding-right:0.4rem; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex">
  <% if (locals.user) { %>
  <aside id="sb" class="no-print hidden md:flex flex-col sidebar-aside">
    <div class="sb-header">
      <span class="sb-brand"><span class="sb-logo">📦</span><span class="sb-label">Inventory</span></span>
      <button type="button" id="sb-toggle" class="sb-toggle" aria-label="Sembunyikan menu">◀</button>
    </div>
    <div class="sb-user"><%= user.nama_lengkap %> (<%= user.role === 'admin' ? 'Admin' : 'Finance' %>)</div>
    <% if (locals.modePresentasi) { %>
    <nav class="sb-nav">
      <a href="/production-batches" class="sb-item <%= currentPath.startsWith('/production-batches') ? 'active' : '' %>">
        <span class="sb-icon">🏭</span><span class="sb-label">Produksi</span>
      </a>
      <div class="sb-group">Data</div>
      <a href="/cek-data/material" class="sb-item <%= currentPath.startsWith('/cek-data') ? 'active' : '' %>">
        <span class="sb-icon">🧵</span><span class="sb-label">Material</span>
      </a>
    </nav>
    <% } else { %>
    <nav class="sb-nav">
      <a href="/dashboard" class="sb-item <%= currentPath === '/dashboard' ? 'active' : '' %>"><span class="sb-icon">📊</span><span class="sb-label">Dashboard</span></a>
      <div class="sb-group">Master Data</div>
      <a href="/cek-data/material" class="sb-item <%= currentPath.startsWith('/cek-data') ? 'active' : '' %>"><span class="sb-icon">🧵</span><span class="sb-label">Material</span></a>
      <a href="/vendors" class="sb-item <%= currentPath.startsWith('/vendors') ? 'active' : '' %>"><span class="sb-icon">🏢</span><span class="sb-label">Vendor</span></a>
      <a href="/products" class="sb-item <%= currentPath.startsWith('/products') ? 'active' : '' %>"><span class="sb-icon">📦</span><span class="sb-label">Produk</span></a>
      <a href="/raw-materials" class="sb-item <%= currentPath.startsWith('/raw-materials') ? 'active' : '' %>"><span class="sb-icon">🧵</span><span class="sb-label">Bahan Baku</span></a>
      <a href="/admin/currencies" class="sb-item <%= currentPath.startsWith('/admin/currencies') ? 'active' : '' %>"><span class="sb-icon">💱</span><span class="sb-label">Currency</span></a>
      <div class="sb-group">Transaksi</div>
      <a href="/purchase-orders" class="sb-item <%= currentPath.startsWith('/purchase-orders') ? 'active' : '' %>"><span class="sb-icon">🛒</span><span class="sb-label">Pembelian Bahan</span></a>
      <a href="/production-batches" class="sb-item <%= currentPath.startsWith('/production-batches') ? 'active' : '' %>"><span class="sb-icon">🏭</span><span class="sb-label">Produksi</span></a>
      <a href="/purchase-imports" class="sb-item <%= currentPath.startsWith('/purchase-imports') ? 'active' : '' %>"><span class="sb-icon">📥</span><span class="sb-label">Beli Jadi</span></a>
      <div class="sb-group">Analisa</div>
      <a href="/hpp" class="sb-item <%= currentPath.startsWith('/hpp') ? 'active' : '' %>"><span class="sb-icon">💰</span><span class="sb-label">HPP</span></a>
      <% if (user.role === 'finance') { %>
      <div class="sb-group">Validasi</div>
      <a href="/validation" class="sb-item <%= currentPath.startsWith('/validation') ? 'active' : '' %>"><span class="sb-icon">✅</span><span class="sb-label">Validasi Finance</span></a>
      <% } %>
      <div class="sb-group">Laporan</div>
      <a href="/reports/stock-card" class="sb-item"><span class="sb-icon">📋</span><span class="sb-label">Kartu Stok</span></a>
      <a href="/reports/monthly-expenses" class="sb-item"><span class="sb-icon">📉</span><span class="sb-label">Pengeluaran</span></a>
    </nav>
    <% } %>
    <div class="sb-footer">
      <% if (!locals.modePresentasi) { %>
      <a href="/logout" class="sb-item"><span class="sb-icon">🚪</span><span class="sb-label">Logout</span></a>
      <% } %>
    </div>
  </aside>
  <script>
    // Collapse sidebar (state disimpan di localStorage)
    (function () {
      var sb = document.getElementById('sb');
      var btn = document.getElementById('sb-toggle');
      if (!sb || !btn) return;
      var collapsed = localStorage.getItem('sbCollapsed') === '1';
      apply();
      btn.addEventListener('click', function () {
        collapsed = !collapsed;
        localStorage.setItem('sbCollapsed', collapsed ? '1' : '0');
        apply();
      });
      function apply() {
        sb.classList.toggle('collapsed', collapsed);
        btn.textContent = collapsed ? '▶' : '◀';
        btn.setAttribute('aria-label', collapsed ? 'Tampilkan menu' : 'Sembunyikan menu');
      }
    })();
  </script>

  <% if (!locals.modePresentasi) { %>
  <!-- mobile bottom nav -->
  <nav class="no-print md:hidden fixed bottom-0 left-0 right-0 bg-gray-800 text-white flex justify-around py-2 z-10 text-xs">
    <a href="/dashboard" class="text-center">📊</a>
    <a href="/vendors" class="text-center">🏢</a>
    <a href="/products" class="text-center">📦</a>
    <a href="/purchase-orders" class="text-center">🛒</a>
    <a href="/production-batches" class="text-center">🏭</a>
    <a href="/admin/currencies" class="text-center">💱</a>
  </nav>
  <% } %>
  <% } %>

  <main class="flex-1 p-4 md:p-6 pb-20 md:pb-6 min-h-screen w-full max-w-7xl mx-auto">
    <% if (locals.success) { %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 text-sm"><%= success %></div>
    <% } %>
    <% if (locals.error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm"><%= error %></div>
    <% } %>
    <%- body %>
  </main>
  <%- locals.script || '' %>
</body>
</html>
