<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof title !== 'undefined' && title) || 'Inventory System' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* ===== Design tokens: shadcn/ui — default neutral theme ===== */
    :root {
      --background: 0 0% 100%;
      --foreground: 240 10% 3.9%;
      --card: 0 0% 100%;
      --card-foreground: 240 10% 3.9%;
      --primary: 240 5.9% 10%;
      --primary-foreground: 0 0% 98%;
      --secondary: 240 4.8% 95.9%;
      --secondary-foreground: 240 5.9% 10%;
      --muted: 240 4.8% 95.9%;
      --muted-foreground: 240 3.8% 46.1%;
      --accent: 240 4.8% 95.9%;
      --accent-foreground: 240 5.9% 10%;
      --destructive: 0 84.2% 60.2%;
      --destructive-foreground: 0 0% 98%;
      --border: 240 5.9% 90%;
      --input: 240 5.9% 90%;
      --ring: 240 10% 3.9%;
      --radius: 0.5rem;
      /* Token sidebar shadcn (block sidebar-07, tema light) */
      --sidebar-background: 0 0% 98%;
      --sidebar-foreground: 240 5.3% 26.1%;
      --sidebar-primary: 240 5.9% 10%;
      --sidebar-primary-foreground: 0 0% 98%;
      --sidebar-accent: 240 4.8% 95.9%;
      --sidebar-accent-foreground: 240 5.9% 10%;
      --sidebar-border: 220 13% 91%;
      --sidebar-ring: 217.2 91.2% 59.8%;
    }
    body { background-color:hsl(var(--background)); color:hsl(var(--foreground)); font-family:ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; }

    /* ===== Sidebar — pola shadcn block sidebar-07 ===== */
    .sidebar-aside { width:16rem; flex-shrink:0; display:flex; flex-direction:column; background:hsl(var(--sidebar-background)); color:hsl(var(--sidebar-foreground)); border-right:1px solid hsl(var(--sidebar-border)); transition:width 220ms ease; }
    .sidebar-aside.collapsed { width:4.5rem; }

    /* Header sidebar: team switcher (logo + nama app) */
    .sb-header { padding:0.5rem; }
    .sb-team { display:flex; align-items:center; gap:0.5rem; padding:0.5rem; border-radius:calc(var(--radius) - 2px); text-decoration:none; color:inherit; transition:background-color 150ms; }
    .sb-team:hover { background:hsl(var(--sidebar-accent)); }
    .sb-logo { width:2rem; height:2rem; flex-shrink:0; border-radius:calc(var(--radius) - 2px); background:hsl(var(--sidebar-primary)); color:hsl(var(--sidebar-primary-foreground)); display:flex; align-items:center; justify-content:center; font-size:1rem; }
    .sb-team-name { display:block; font-size:0.9rem; font-weight:600; line-height:1.2; white-space:nowrap; overflow:hidden; }
    .sb-team-sub { display:block; font-size:0.72rem; color:hsl(var(--muted-foreground)); white-space:nowrap; overflow:hidden; }

    .sb-scroll { flex:1; overflow-y:auto; overflow-x:hidden; padding:0.5rem; display:flex; flex-direction:column; gap:0.25rem; }
    .sb-scroll::-webkit-scrollbar { width:4px; }
    .sb-scroll::-webkit-scrollbar-track { background:transparent; }
    .sb-scroll::-webkit-scrollbar-thumb { background:rgba(0,0,0,0.12); border-radius:4px; }

    .sb-group { font-size:0.75rem; color:hsl(var(--sidebar-foreground) / 0.7); padding:0.9rem 0.5rem 0.25rem; font-weight:500; white-space:nowrap; overflow:hidden; }
    .sb-item { display:flex; align-items:center; gap:0.6rem; padding:0.5rem 0.55rem; border-radius:calc(var(--radius) - 2px); color:hsl(var(--sidebar-foreground)); text-decoration:none; font-size:0.875rem; font-weight:500; transition:background-color 150ms, color 150ms; white-space:nowrap; overflow:hidden; }
    .sb-item:hover { background:hsl(var(--sidebar-accent)); color:hsl(var(--sidebar-accent-foreground)); }
    .sb-item.active { background:hsl(var(--sidebar-accent)); color:hsl(var(--sidebar-accent-foreground)); font-weight:600; }
    .sb-icon { display:inline-flex; flex-shrink:0; font-size:1rem; width:1.4rem; justify-content:center; }

    /* Footer sidebar: user card (pola NavUser sidebar-07) */
    .sb-footer { padding:0.5rem; border-top:1px solid hsl(var(--sidebar-border)); }
    .sb-user { display:flex; align-items:center; gap:0.5rem; padding:0.5rem; border-radius:calc(var(--radius) - 2px); transition:background-color 150ms; }
    .sb-user:hover { background:hsl(var(--sidebar-accent)); }
    .sb-avatar { width:2rem; height:2rem; flex-shrink:0; border-radius:calc(var(--radius) - 2px); background:hsl(var(--sidebar-primary)); color:hsl(var(--sidebar-primary-foreground)); display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:600; }
    .sb-user-info { flex:1; min-width:0; }
    .sb-user-name { display:block; font-size:0.8rem; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .sb-user-role { display:block; font-size:0.72rem; color:hsl(var(--muted-foreground)); white-space:nowrap; }
    .sb-logout { display:flex; align-items:center; justify-content:center; width:1.9rem; height:1.9rem; flex-shrink:0; border-radius:calc(var(--radius) - 2px); color:hsl(var(--muted-foreground)); font-size:1rem; transition:background-color 150ms, color 150ms; }
    .sb-logout:hover { background:hsl(var(--sidebar-accent)); color:hsl(var(--destructive)); }

    .sidebar-aside.collapsed .sb-label,
    .sidebar-aside.collapsed .sb-team-name,
    .sidebar-aside.collapsed .sb-team-sub,
    .sidebar-aside.collapsed .sb-user-info,
    .sidebar-aside.collapsed .sb-logout { display:none; }
    .sidebar-aside.collapsed .sb-team { justify-content:center; padding:0.5rem 0.25rem; }
    .sidebar-aside.collapsed .sb-item { justify-content:center; padding:0.5rem 0.25rem; }
    .sidebar-aside.collapsed .sb-user { justify-content:center; padding:0.5rem 0.25rem; }
    .sidebar-aside.collapsed .sb-group { font-size:0; padding:0.7rem 0 0.2rem; }

    /* ===== Header konten — pola header SidebarInset sidebar-07 ===== */
    .app-header { position:sticky; top:0; z-index:20; height:3.5rem; display:flex; align-items:center; gap:0.5rem; padding:0 1rem; background:hsl(var(--background) / 0.95); backdrop-filter:blur(4px); border-bottom:1px solid hsl(var(--border)); }
    .app-trigger { display:flex; align-items:center; justify-content:center; width:2rem; height:2rem; margin-left:-0.25rem; border:none; background:transparent; border-radius:calc(var(--radius) - 2px); color:hsl(var(--muted-foreground)); cursor:pointer; font-size:1rem; transition:background-color 150ms, color 150ms; }
    .app-trigger:hover { background:hsl(var(--accent)); color:hsl(var(--accent-foreground)); }
    .app-sep { width:1px; height:1rem; background:hsl(var(--border)); margin-right:0.5rem; }
    .app-crumb { display:flex; align-items:center; gap:0.5rem; font-size:0.875rem; color:hsl(var(--muted-foreground)); min-width:0; }
    .app-crumb-current { color:hsl(var(--foreground)); font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .app-avatar { margin-left:auto; width:2rem; height:2rem; flex-shrink:0; border-radius:9999px; background:hsl(var(--primary)); color:hsl(var(--primary-foreground)); display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:600; }

    /* ===== Card ===== */
    .card { background:hsl(var(--card)); border-radius:var(--radius); border:1px solid hsl(var(--border)); box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.04); }
    .card-header { padding:1rem 1.5rem; border-bottom:1px solid hsl(var(--border)); }
    .card-body { padding:1.5rem; }
    .stat-card { background:hsl(var(--card)); border-radius:var(--radius); border:1px solid hsl(var(--border)); box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.04); padding:1.25rem; transition:border-color 200ms, box-shadow 200ms; }
    .stat-card:hover { box-shadow:0 4px 12px 0 rgb(0 0 0 / 0.06); border-color:hsl(var(--ring) / 0.25); }

    /* ===== Table ===== */
    .table-container { background:hsl(var(--card)); border-radius:var(--radius); border:1px solid hsl(var(--border)); box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.04); overflow-x:auto; }
    .table-container table { width:100%; font-size:0.875rem; border-collapse:collapse; }
    .table-container thead { background:hsl(var(--muted)); }
    .table-container th { padding:0.875rem 1rem; text-align:left; font-size:0.75rem; font-weight:600; color:hsl(var(--muted-foreground)); text-transform:uppercase; letter-spacing:0.05em; }
    .table-container td { padding:0.875rem 1rem; font-size:0.875rem; color:hsl(var(--foreground)); }
    .table-container tbody tr { border-top:1px solid hsl(var(--border)); transition:background-color 150ms; }
    .table-container tbody tr:hover { background:hsl(var(--muted) / 0.5); }

    /* ===== Badge ===== */
    .badge { display:inline-flex; align-items:center; gap:0.25rem; padding:0.125rem 0.625rem; font-size:0.75rem; font-weight:500; border-radius:calc(var(--radius) - 2px); border:1px solid transparent; }

    /* ===== Form controls ===== */
    .input-field { width:100%; border:1px solid hsl(var(--input)); border-radius:calc(var(--radius) - 2px); padding:0.625rem 0.875rem; font-size:0.875rem; background:hsl(var(--background)); color:hsl(var(--foreground)); transition:border-color 200ms, box-shadow 200ms; outline:none; }
    .input-field:focus { border-color:hsl(var(--ring)); box-shadow:0 0 0 3px hsl(var(--ring) / 0.12); }
    .input-field::placeholder { color:hsl(var(--muted-foreground)); }
    .input-label { display:block; font-size:0.875rem; font-weight:500; color:hsl(var(--foreground)); margin-bottom:0.375rem; }

    /* ===== Buttons ===== */
    .btn { display:inline-flex; align-items:center; justify-content:center; gap:0.5rem; padding:0.625rem 1rem; font-size:0.875rem; font-weight:500; border-radius:calc(var(--radius) - 2px); transition:background-color 200ms, box-shadow 200ms; text-decoration:none; border:none; cursor:pointer; outline:none; }
    .btn:focus { box-shadow:0 0 0 3px hsl(var(--ring) / 0.25); }
    .btn-primary { background:hsl(var(--primary)); color:hsl(var(--primary-foreground)); }
    .btn-primary:hover { background:hsl(240 5.9% 10% / 0.9); }
    .btn-success { background:#059669; color:#fff; }
    .btn-success:hover { background:#047857; }
    .btn-danger { background:hsl(var(--destructive)); color:hsl(var(--destructive-foreground)); }
    .btn-danger:hover { background:hsl(0 84.2% 60.2% / 0.9); }
    .btn-ghost { color:hsl(var(--muted-foreground)); }
    .btn-ghost:hover { background:hsl(var(--accent)); color:hsl(var(--accent-foreground)); }
    .btn-sm { padding:0.375rem 0.75rem; font-size:0.75rem; }

    /* ===== Alerts ===== */
    .alert { display:flex; align-items:flex-start; gap:0.75rem; padding:0.875rem 1rem; border-radius:var(--radius); font-size:0.875rem; }
    .alert-warning { background:#fffbeb; border:1px solid #fde68a; color:#92400e; }
    .alert-info { background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; }
    .alert-success { background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46; }
    .alert-error { background:#fef2f2; border:1px solid #fecaca; color:#991b1b; }

    /* ===== Progress ===== */
    .progress-bar { background:hsl(var(--muted)); border-radius:9999px; height:0.625rem; overflow:hidden; }
    .progress-fill { height:100%; border-radius:9999px; transition:all 500ms; }

    /* ===== Form card ===== */
    .form-card { background:hsl(var(--card)); border:1px solid hsl(var(--border)); border-radius:var(--radius); box-shadow:0 1px 2px 0 rgb(0 0 0 / 0.04); padding:1.5rem; max-width:42rem; }
    .form-card.max-w-xl, .form-card.max-w-2xl, .form-card.max-w-3xl { max-width:none; }
    .form-section { margin-bottom:1.5rem; }
    .form-grid { display:grid; grid-template-columns:1fr; gap:1rem; margin-bottom:1.5rem; }
    @media (min-width:640px){ .form-grid { grid-template-columns:1fr 1fr; } }

    /* ===== Page header ===== */
    .page-header { display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1.5rem; }
    @media (min-width:640px){ .page-header { flex-direction:row; align-items:center; justify-content:space-between; } }
    .page-title { font-size:1.25rem; font-weight:700; color:hsl(var(--foreground)); letter-spacing:-0.025em; }
    @media (min-width:640px){ .page-title { font-size:1.5rem; } }

    @media print { .no-print { display: none !important; } }

    /* ===== Fitur 9: urgent row & banner ===== */
    .urgent-row { background:#fef3c7 !important; }
    .urgent-row-critical { background:#fee2e2 !important; }
    .dismiss-banner { float:right; background:transparent; border:none; color:inherit; cursor:pointer; font-size:1.25rem; line-height:1; }

    /* ===== Mobile bottom nav ===== */
    .mob-nav a { color:hsl(var(--muted-foreground)); padding:0.4rem 0.6rem; border-radius:var(--radius); }
    .mob-nav a.mob-active { color:hsl(var(--foreground)); background:hsl(var(--accent)); }

    /* ===== Lucide icons (pengganti emoji) ===== */
    svg.lucide { width:1em; height:1em; display:inline-block; vertical-align:-0.125em; stroke-width:2; flex-shrink:0; }
  </style>
</head>
<body class="min-h-screen flex">
  <% if (locals.user) { %>
  <%
    const _nama = user.nama_lengkap || 'User';
    const _initials = _nama.trim().split(/\s+/).map(function (w) { return w.charAt(0); }).slice(0, 2).join('').toUpperCase();
    const _roleLabel = user.role === 'admin' ? 'Admin' : 'Finance';
    const _pageTitle = (typeof title !== 'undefined' && title) || '';
  %>
  <aside id="sb" class="no-print hidden md:flex sidebar-aside">
    <div class="sb-header">
      <a href="/<%= locals.modePresentasi ? 'production-batches' : 'dashboard' %>" class="sb-team">
        <span class="sb-logo"><i data-lucide="package"></i></span>
        <span class="sb-label">
          <span class="sb-team-name">Inventory</span>
          <span class="sb-team-sub">Fashion UMKM</span>
        </span>
      </a>
    </div>
    <% if (locals.modePresentasi) { %>
    <nav class="sb-scroll">
      <div class="sb-group">Menu</div>
      <a href="/production-batches" class="sb-item <%= currentPath.startsWith('/production-batches') ? 'active' : '' %>">
        <span class="sb-icon"><i data-lucide="factory"></i></span><span class="sb-label">Produksi</span>
      </a>
      <a href="/cek-data/material" class="sb-item <%= currentPath.startsWith('/cek-data') ? 'active' : '' %>">
        <span class="sb-icon"><i data-lucide="shirt"></i></span><span class="sb-label">Material</span>
      </a>
    </nav>
    <% } else { %>
    <nav class="sb-scroll">
      <a href="/dashboard" class="sb-item <%= currentPath === '/dashboard' ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="layout-dashboard"></i></span><span class="sb-label">Dashboard</span></a>
      <div class="sb-group">Master Data</div>
      <a href="/cek-data/material" class="sb-item <%= currentPath.startsWith('/cek-data') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="shirt"></i></span><span class="sb-label">Material</span></a>
      <a href="/vendors" class="sb-item <%= currentPath.startsWith('/vendors') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="building-2"></i></span><span class="sb-label">Vendor</span></a>
      <a href="/products" class="sb-item <%= currentPath.startsWith('/products') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="package"></i></span><span class="sb-label">Produk</span></a>
      <a href="/raw-materials" class="sb-item <%= currentPath.startsWith('/raw-materials') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="layers"></i></span><span class="sb-label">Bahan Baku</span></a>
      <a href="/admin/currencies" class="sb-item <%= currentPath.startsWith('/admin/currencies') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="coins"></i></span><span class="sb-label">Currency</span></a>
      <div class="sb-group">Transaksi</div>
      <a href="/purchase-orders" class="sb-item <%= currentPath.startsWith('/purchase-orders') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="shopping-cart"></i></span><span class="sb-label">Pembelian Bahan</span></a>
      <a href="/production-batches" class="sb-item <%= currentPath.startsWith('/production-batches') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="factory"></i></span><span class="sb-label">Produksi</span></a>
      <a href="/purchase-imports" class="sb-item <%= currentPath.startsWith('/purchase-imports') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="download"></i></span><span class="sb-label">Beli Jadi</span></a>
      <div class="sb-group">Analisa</div>
      <a href="/hpp" class="sb-item <%= currentPath.startsWith('/hpp') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="calculator"></i></span><span class="sb-label">HPP</span></a>
      <% if (user.role === 'finance') { %>
      <div class="sb-group">Validasi</div>
      <a href="/validation" class="sb-item <%= currentPath.startsWith('/validation') ? 'active' : '' %>"><span class="sb-icon"><i data-lucide="badge-check"></i></span><span class="sb-label">Validasi Finance</span></a>
      <% } %>
      <div class="sb-group">Laporan</div>
      <a href="/reports/stock-card" class="sb-item"><span class="sb-icon"><i data-lucide="clipboard-list"></i></span><span class="sb-label">Kartu Stok</span></a>
      <a href="/reports/monthly-expenses" class="sb-item"><span class="sb-icon"><i data-lucide="trending-down"></i></span><span class="sb-label">Pengeluaran</span></a>
    </nav>
    <% } %>
    <div class="sb-footer">
      <div class="sb-user">
        <span class="sb-avatar"><%= _initials %></span>
        <span class="sb-user-info">
          <span class="sb-user-name"><%= user.nama_lengkap %></span>
          <span class="sb-user-role"><%= _roleLabel %></span>
        </span>
        <% if (!locals.modePresentasi) { %>
        <a href="/logout" class="sb-logout" title="Logout" aria-label="Logout"><i data-lucide="log-out"></i></a>
        <% } %>
      </div>
    </div>
  </aside>

  <div class="flex-1 flex flex-col min-w-0">
    <header class="app-header no-print">
      <button type="button" id="sb-toggle" class="app-trigger hidden md:flex" aria-label="Toggle sidebar"><i data-lucide="panel-left"></i></button>
      <span class="app-sep hidden md:block"></span>
      <nav class="app-crumb" aria-label="Breadcrumb">
        <span>Inventory</span>
        <% if (_pageTitle) { %>
        <span>/</span>
        <span class="app-crumb-current"><%= _pageTitle %></span>
        <% } %>
      </nav>
      <% if (!locals.modePresentasi) { %>
      <span class="app-avatar" title="<%= user.nama_lengkap %>"><%= _initials %></span>
      <% } %>
    </header>
  <% } %>

    <main class="flex-1 p-4 md:p-6 pb-20 md:pb-6 min-h-screen w-full max-w-7xl mx-auto">
      <% if (locals.success) { %>
        <div class="alert alert-success mb-4"><%= success %></div>
      <% } %>
      <% if (locals.error) { %>
        <div class="alert alert-error mb-4"><%= error %></div>
      <% } %>
      <%- body %>
    </main>
  <% if (locals.user) { %>
  </div>

  <% if (!locals.modePresentasi) { %>
  <!-- mobile bottom nav -->
  <nav class="mob-nav no-print md:hidden fixed bottom-0 left-0 right-0 flex justify-around py-2 z-10 text-xs" style="background:hsl(var(--background)); border-top:1px solid hsl(var(--border));">
    <a href="/dashboard" class="text-center <%= currentPath === '/dashboard' ? 'mob-active' : '' %>" style="font-size:1.25rem"><i data-lucide="layout-dashboard"></i></a>
    <a href="/vendors" class="text-center <%= currentPath.startsWith('/vendors') ? 'mob-active' : '' %>" style="font-size:1.25rem"><i data-lucide="building-2"></i></a>
    <a href="/products" class="text-center <%= currentPath.startsWith('/products') ? 'mob-active' : '' %>" style="font-size:1.25rem"><i data-lucide="package"></i></a>
    <a href="/purchase-orders" class="text-center <%= currentPath.startsWith('/purchase-orders') ? 'mob-active' : '' %>" style="font-size:1.25rem"><i data-lucide="shopping-cart"></i></a>
    <a href="/production-batches" class="text-center <%= currentPath.startsWith('/production-batches') ? 'mob-active' : '' %>" style="font-size:1.25rem"><i data-lucide="factory"></i></a>
    <a href="/admin/currencies" class="text-center <%= currentPath.startsWith('/admin/currencies') ? 'mob-active' : '' %>" style="font-size:1.25rem"><i data-lucide="coins"></i></a>
  </nav>
  <% } %>
  <script>
    // Collapse sidebar (state disimpan di localStorage) — trigger di header
    (function () {
      var sb = document.getElementById('sb');
      var btn = document.getElementById('sb-toggle');
      if (!sb || !btn) return;
      var collapsed = localStorage.getItem('sbCollapsed') === '1';
      apply();
      btn.addEventListener('click', function () {
        collapsed = !collapsed;
        localStorage.setItem('sbCollapsed', collapsed ? '1' : '0');
        apply();
      });
      function apply() {
        sb.classList.toggle('collapsed', collapsed);
        btn.setAttribute('aria-label', collapsed ? 'Tampilkan menu' : 'Sembunyikan menu');
      }
    })();
  </script>
  <% } %>
  <%- locals.script || '' %>
  <script src="/vendor/lucide.min.js"></script>
  <script>if (window.lucide) lucide.createIcons();</script>
</body>
</html>
