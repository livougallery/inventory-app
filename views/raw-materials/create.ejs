<h1 class="text-2xl font-bold mb-4">Tambah Bahan Baku</h1>
<form method="POST" action="/raw-materials" class="bg-white shadow rounded p-6 max-w-xl">
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Nama Bahan</label>
    <input type="text" name="nama" class="w-full border rounded p-2" required>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Kategori</label>
    <select name="tipe" class="w-full border rounded p-2">
      <option value="kain_roll">Fabric Roll</option>
      <option value="kain_ecer">Kain Ecer (Meteran)</option>
      <option value="cmt_cost">Product Fulfillment</option>
      <option value="aksesoris">Aksesoris</option>
    </select>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Satuan</label>
    <input type="text" name="satuan" placeholder="Contoh: meter, pcs, lusin" class="w-full border rounded p-2" required>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Stok Minimum (alert)</label>
    <input type="number" name="stok_minimum" step="any" class="w-full border rounded p-2">
  </div>
  <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Simpan</button>
  <a href="/raw-materials" class="ml-2 text-gray-500 hover:underline">Batal</a>
</form>
