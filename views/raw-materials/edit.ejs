<h1 class="text-2xl font-bold mb-4">Edit Bahan Baku</h1>
<form method="POST" action="/raw-materials/<%= material.id %>?_method=PUT" class="bg-white shadow rounded p-6 max-w-xl">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Nama Bahan</label>
    <input type="text" name="nama" value="<%= material.nama %>" class="w-full border rounded p-2" required>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Kategori</label>
    <select name="tipe" class="w-full border rounded p-2">
      <option value="kain_roll" <%= material.tipe === 'kain_roll' ? 'selected' : '' %>>Fabric Roll</option>
      <option value="kain_ecer" <%= material.tipe === 'kain_ecer' ? 'selected' : '' %>>Kain Ecer (Meteran)</option>
      <option value="cmt_cost" <%= material.tipe === 'cmt_cost' ? 'selected' : '' %>>Product Fulfillment</option>
      <option value="aksesoris" <%= material.tipe === 'aksesoris' ? 'selected' : '' %>>Aksesoris</option>
    </select>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Satuan</label>
    <input type="text" name="satuan" value="<%= material.satuan %>" class="w-full border rounded p-2" required>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Stok Minimum</label>
    <input type="number" name="stok_minimum" step="any" value="<%= material.stok_minimum || '' %>" class="w-full border rounded p-2">
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Stok Saat Ini (read-only)</label>
    <input type="number" name="stok_display" value="<%= material.stok %>" class="w-full border rounded p-2 bg-gray-100 cursor-not-allowed" disabled
           title="Stok hanya bisa berubah via PO atau stock movement. Gunakan tombol 'Adjust Stok' di halaman show.">
    <input type="hidden" name="stok" value="<%= material.stok %>">
    <p class="text-xs text-gray-500 mt-1">Stok hanya berubah via PO atau stock_movements.</p>
  </div>
  <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Simpan Perubahan</button>
  <a href="/raw-materials" class="ml-2 text-gray-500 hover:underline">Batal</a>
</form>
