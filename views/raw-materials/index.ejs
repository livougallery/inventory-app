<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">Bahan Baku</h1>
  <% if (user.role === 'admin') { %>
    <a href="/raw-materials/create" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">+ Tambah</a>
  <% } %>
</div>
<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Nama</th>
      <th class="p-3 text-left">Tipe</th>
      <th class="p-3 text-left">Satuan</th>
      <th class="p-3 text-right">Stok</th>
      <th class="p-3 text-right">Min Stok</th>
      <% if (user.role === 'admin') { %><th class="p-3 text-left">Aksi</th><% } %>
    </tr></thead>
    <tbody>
      <% materials.forEach(m => { %>
      <%
        const isLow = m.stok_minimum != null && m.stok < m.stok_minimum;
      %>
      <tr class="border-t hover:bg-gray-50 <%= isLow ? 'urgent-row-critical' : '' %>">
        <td class="p-3 font-medium"><%= m.nama %></td>
        <td class="p-3">
          <span class="px-2 py-0.5 text-xs rounded-full
            <%= m.tipe === 'kain_roll' ? 'bg-indigo-100 text-indigo-700' : '' %>
            <%= m.tipe === 'kain_ecer' ? 'bg-pink-100 text-pink-700' : '' %>
            <%= m.tipe === 'aksesoris' ? 'bg-yellow-100 text-yellow-700' : '' %>">
            <%= m.tipe === 'kain_roll' ? 'Kain Roll' : m.tipe === 'kain_ecer' ? 'Kain Ecer' : 'Aksesoris' %>
          </span>
        </td>
        <td class="p-3"><%= m.satuan %></td>
        <td class="p-3 text-right <%= m.stok_minimum && m.stok <= m.stok_minimum ? 'text-red-600 font-bold' : '' %>"><%= Number(m.stok).toLocaleString('id-ID') %></td>
        <td class="p-3 text-right"><%= m.stok_minimum ? Number(m.stok_minimum).toLocaleString('id-ID') : '-' %></td>
        <% if (user.role === 'admin') { %>
        <td class="p-3">
          <a href="/raw-materials/<%= m.id %>/edit" class="text-blue-600 hover:underline mr-2">Edit</a>
          <form method="POST" action="/raw-materials/<%= m.id %>?_method=DELETE" style="display:inline"
                onsubmit="return confirm('Hapus <%= m.nama %>?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="text-red-600 hover:underline">Hapus</button>
          </form>
        </td>
        <% } %>
      </tr>
      <% }) %>
      <% if (materials.length === 0) { %><tr><td colspan="6" class="p-3 text-center text-gray-400">Belum ada bahan baku</td></tr><% } %>
    </tbody>
  </table>
</div>
