<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">Data Produk</h1>
  <% if (user.role === 'admin') { %>
    <a href="/products/create" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">+ Tambah</a>
  <% } %>
</div>
<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Nama Produk</th>
      <th class="p-3 text-left">Kategori</th>
      <th class="p-3 text-left">Tipe</th>
      <th class="p-3 text-center">Varian</th>
      <th class="p-3 text-left">Aksi</th>
    </tr></thead>
    <tbody>
      <% products.forEach(p => { %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-3 font-medium"><a href="/products/<%= p.id %>" class="text-blue-600 hover:underline"><%= p.nama_produk %></a></td>
        <td class="p-3"><%= p.kategori || '-' %></td>
        <td class="p-3">
          <span class="px-2 py-0.5 text-xs rounded-full <%= p.tipe_produksi === 'sendiri' ? 'bg-orange-100 text-orange-700' : 'bg-teal-100 text-teal-700' %>">
            <%= p.tipe_produksi === 'sendiri' ? 'Produksi Sendiri' : 'Beli Jadi' %>
          </span>
        </td>
        <td class="p-3 text-center"><%= p.varian_count %></td>
        <td class="p-3">
          <a href="/products/<%= p.id %>" class="text-blue-600 hover:underline mr-2">Detail</a>
          <% if (user.role === 'admin') { %>
          <a href="/products/<%= p.id %>/edit" class="text-blue-600 hover:underline mr-2">Edit</a>
          <form method="POST" action="/products/<%= p.id %>?_method=DELETE" style="display:inline"
                onsubmit="return confirm('Hapus <%= p.nama_produk %>?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="text-red-600 hover:underline">Hapus</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (products.length === 0) { %><tr><td colspan="5" class="p-3 text-center text-gray-400">Belum ada produk</td></tr><% } %>
    </tbody>
  </table>
</div>
