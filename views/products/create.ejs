<h1 class="text-2xl font-bold mb-4">Tambah Produk</h1>
<form method="POST" action="/products" class="bg-white shadow rounded p-6 max-w-2xl">
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Nama Produk</label>
    <input type="text" name="nama_produk" class="w-full border rounded p-2" required>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Kategori</label>
    <input type="text" name="kategori" placeholder="Contoh: Atasan, Bawahan, Dress" class="w-full border rounded p-2">
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Tipe Produksi</label>
    <select name="tipe_produksi" class="w-full border rounded p-2">
      <option value="sendiri">Produksi Sendiri</option>
      <option value="beli_jadi">Beli Jadi</option>
    </select>
  </div>
  <div class="mb-4">
    <label class="block mb-1 text-sm font-medium">Varian (Warna × Size)</label>
    <div id="variants-container">
      <div class="variant-row flex gap-2 mb-2">
        <input name="variants[0][warna]" placeholder="Warna" class="border p-2 rounded flex-1">
        <input name="variants[0][size]" placeholder="Size" class="border p-2 rounded w-20">
        <input name="variants[0][sku]" placeholder="SKU" class="border p-2 rounded flex-1">
        <button type="button" class="remove-variant text-red-500 px-2 font-bold">✕</button>
      </div>
    </div>
    <button type="button" id="add-variant" class="text-blue-600 text-sm hover:underline mt-1">+ Tambah Varian</button>
  </div>
  <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Simpan</button>
  <a href="/products" class="ml-2 text-gray-500 hover:underline">Batal</a>
</form>
<script>
let vi = 1;
document.getElementById('add-variant')?.addEventListener('click', () => {
  const html = `<div class="variant-row flex gap-2 mb-2">
    <input name="variants[${vi}][warna]" placeholder="Warna" class="border p-2 rounded flex-1">
    <input name="variants[${vi}][size]" placeholder="Size" class="border p-2 rounded w-20">
    <input name="variants[${vi}][sku]" placeholder="SKU" class="border p-2 rounded flex-1">
    <button type="button" class="remove-variant text-red-500 px-2 font-bold">✕</button>
  </div>`;
  document.getElementById('variants-container').insertAdjacentHTML('beforeend', html);
  vi++;
});
document.addEventListener('click', (e) => {
  if (e.target.classList.contains('remove-variant')) e.target.closest('.variant-row').remove();
});
</script>
