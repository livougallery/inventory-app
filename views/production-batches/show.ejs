<div class="mb-4">
  <a href="/production-batches" class="text-blue-600 hover:underline text-sm">← Kembali</a>
</div>

<h1 class="text-2xl font-bold mb-1"><%= batch.nama_batch %></h1>
<p class="text-gray-500 mb-4">
  Produk: <strong><%= batch.nama_produk %></strong> |
  Jenis: <strong><%= batch.jenis_produksi === 'in_house' ? 'In House' : batch.jenis_produksi === 'konveksi' ? 'Konveksi' : 'Garment' %></strong>
  <% if (batch.vendor_nama) { %> | Vendor: <strong><%= batch.vendor_nama %></strong><% } %> |
  Progress: <strong><%= batch.jumlah_selesai %>/<%= batch.jumlah_dipesan %></strong>
</p>

<% if (user.role === 'admin' && batch.status !== 'completed') { %>
<div class="bg-white shadow rounded p-4 mb-4">
  <h3 class="font-bold mb-2">📥 Input Kedatangan Barang</h3>
  <form method="POST" action="/production-batches/<%= batch.id %>/deliveries" class="flex flex-wrap gap-2 items-end">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label class="block text-xs text-gray-500">Varian</label>
      <select name="variant_id" class="border rounded p-2" required>
        <option value="">Pilih Varian</option>
        <% batch.variants.forEach(v => { %>
        <option value="<%= v.id %>"><%= v.warna %> - <%= v.size %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-xs text-gray-500">Tanggal Datang</label>
      <input type="date" name="tgl_datang" value="<%= new Date().toISOString().split('T')[0] %>" class="border rounded p-2" required>
    </div>
    <div>
      <label class="block text-xs text-gray-500">Jumlah (pcs)</label>
      <input type="number" name="qty_datang" class="border rounded p-2 w-20" required min="1">
    </div>
    <div>
      <label class="block text-xs text-gray-500">Keterangan</label>
      <input type="text" name="keterangan" class="border rounded p-2">
    </div>
    <button type="submit" class="bg-green-600 text-white px-3 py-2 rounded text-sm hover:bg-green-700">Catat</button>
  </form>
</div>
<% } %>

<h2 class="font-bold text-lg mb-2">Riwayat Kedatangan</h2>
<div class="bg-white shadow rounded overflow-x-auto mb-6">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Tanggal</th>
      <th class="p-3 text-left">Varian</th>
      <th class="p-3 text-right">Qty</th>
      <th class="p-3 text-left">Keterangan</th>
    </tr></thead>
    <tbody>
      <% batch.deliveries.forEach(d => { %>
      <tr class="border-t">
        <td class="p-3"><%= d.tgl_datang %></td>
        <td class="p-3"><%= d.warna %> - <%= d.size %></td>
        <td class="p-3 text-right"><%= d.qty_datang %></td>
        <td class="p-3"><%= d.keterangan || '-' %></td>
      </tr>
      <% }) %>
      <% if (batch.deliveries.length === 0) { %><tr><td colspan="4" class="p-3 text-center text-gray-400">Belum ada kedatangan</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="flex justify-between items-center mb-2">
  <h2 class="font-bold text-lg">Biaya Produksi</h2>
  <% if (user.role === 'admin' && batch.status !== 'completed') { %>
    <a href="/production-batches/<%= batch.id %>/add-cost" class="bg-blue-600 text-white px-3 py-1.5 rounded text-sm hover:bg-blue-700">+ Tambah Biaya</a>
  <% } %>
</div>
<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Tipe Biaya</th>
      <th class="p-3 text-left">Varian</th>
      <th class="p-3 text-left">Material</th>
      <th class="p-3 text-right">Qty</th>
      <th class="p-3 text-right">Biaya</th>
      <th class="p-3 text-left">Status</th>
    </tr></thead>
    <tbody>
      <% batch.costs.forEach(c => { %>
      <tr class="border-t">
        <td class="p-3"><%= c.tipe_biaya === 'kirim_aksesoris' ? 'Kirim Aksesoris' : c.tipe_biaya.charAt(0).toUpperCase() + c.tipe_biaya.slice(1) %></td>
        <td class="p-3"><%= c.warna ? c.warna + ' - ' + c.size : 'Semua Varian' %></td>
        <td class="p-3"><%= c.material_nama || '-' %></td>
        <td class="p-3 text-right"><%= c.qty_terpakai ? Number(c.qty_terpakai).toLocaleString('id-ID') : '-' %></td>
        <td class="p-3 text-right">Rp <%= Number(c.biaya).toLocaleString('id-ID') %></td>
        <td class="p-3">
          <span class="px-2 py-0.5 text-xs rounded-full
            <%= c.status_validasi === 'pending' ? 'bg-yellow-100 text-yellow-700' : '' %>
            <%= c.status_validasi === 'validated' ? 'bg-green-100 text-green-700' : '' %>
            <%= c.status_validasi === 'rejected' ? 'bg-red-100 text-red-700' : '' %>">
            <%= c.status_validasi === 'pending' ? 'Pending' : c.status_validasi === 'validated' ? 'Valid' : 'Ditolak' %>
          </span>
        </td>
      </tr>
      <% }) %>
      <% if (batch.costs.length === 0) { %><tr><td colspan="6" class="p-3 text-center text-gray-400">Belum ada biaya</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card mt-6">
  <div class="card-header flex justify-between items-center">
    <span><i class="fas fa-calculator"></i> Kalkulator HPP</span>
    <span id="fallback-warn" class="alert-warning text-xs px-2 py-1 rounded hidden">Formula custom invalid — pakai default</span>
  </div>
  <div class="card-body">
    <label class="input-label">Formula Config (JSON)</label>
    <textarea id="formula-json" class="input-field font-mono text-xs" rows="6" placeholder='{"mode":"weighted_avg","fields":["biaya"]}'><%- batch.formula_json || '{"mode":"weighted_avg","fields":["biaya"]}' %></textarea>
    <div class="flex gap-2 mt-2">
      <button type="button" class="btn btn-primary btn-sm" onclick="previewHpp()"><i class="fas fa-play"></i> Preview</button>
      <button type="button" class="btn btn-success btn-sm" onclick="applyFormula()"><i class="fas fa-save"></i> Apply Formula</button>
    </div>

    <div id="hpp-preview" class="alert-info mt-4" style="display:none">
      <p class="font-semibold mb-2">Preview HPP</p>
      <pre id="hpp-preview-content" class="text-xs"></pre>
    </div>
  </div>
</div>

<script>
async function previewHpp() {
  const r = await fetch('/production-batches/<%= batch.id %>/hpp-preview');
  const j = await r.json();
  document.getElementById('hpp-preview').style.display='block';
  document.getElementById('hpp-preview-content').textContent = JSON.stringify(j, null, 2);
  document.getElementById('fallback-warn').classList.toggle('hidden', !j.fallback);
}
async function applyFormula() {
  const json = document.getElementById('formula-json').value;
  const fd = new FormData();
  fd.append('formula_json', json);
  fd.append('_csrf', '<%= csrfToken %>');
  const r = await fetch('/production-batches/<%= batch.id %>/formula', { method:'POST', body: fd });
  if (r.ok || r.redirected) location.reload();
  else alert('Gagal menyimpan formula');
}
</script>
