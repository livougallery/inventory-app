<div class="flex justify-between items-center mb-4">
  <h1 class="text-2xl font-bold">Batch Produksi</h1>
  <% if (user.role === 'admin') { %>
    <a href="/production-batches/create" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">+ Buat Batch</a>
  <% } %>
</div>
<div class="bg-white shadow rounded overflow-x-auto">
  <table class="w-full text-sm">
    <thead><tr class="bg-gray-100">
      <th class="p-3 text-left">Batch</th>
      <th class="p-3 text-left">Produk</th>
      <th class="p-3 text-left">Jenis</th>
      <th class="p-3 text-right">Progress</th>
      <th class="p-3 text-left">Status</th>
      <th class="p-3 text-left">Aksi</th>
    </tr></thead>
    <tbody>
      <% batches.forEach(b => { %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-3 font-medium"><%= b.nama_batch %></td>
        <td class="p-3"><%= b.nama_produk %></td>
        <td class="p-3">
          <span class="px-2 py-0.5 text-xs rounded-full
            <%= b.jenis_produksi === 'in_house' ? 'bg-green-100 text-green-700' : '' %>
            <%= b.jenis_produksi === 'konveksi' ? 'bg-blue-100 text-blue-700' : '' %>
            <%= b.jenis_produksi === 'garment' ? 'bg-purple-100 text-purple-700' : '' %>">
            <%= b.jenis_produksi === 'in_house' ? 'In House' : b.jenis_produksi === 'konveksi' ? 'Konveksi' : 'Garment' %>
          </span>
        </td>
        <td class="p-3 text-right"><%= b.jumlah_selesai %>/<%= b.jumlah_dipesan %></td>
        <td class="p-3">
          <span class="px-2 py-0.5 text-xs rounded-full
            <%= b.status === 'planned' ? 'bg-gray-100 text-gray-700' : '' %>
            <%= b.status === 'in_progress' ? 'bg-yellow-100 text-yellow-700' : '' %>
            <%= b.status === 'completed' ? 'bg-green-100 text-green-700' : '' %>">
            <%= b.status === 'planned' ? 'Rencana' : b.status === 'in_progress' ? 'Berjalan' : 'Selesai' %>
          </span>
        </td>
        <td class="p-3"><a href="/production-batches/<%= b.id %>" class="text-blue-600 hover:underline">Detail</a></td>
      </tr>
      <% }) %>
      <% if (batches.length === 0) { %><tr><td colspan="6" class="p-3 text-center text-gray-400">Belum ada batch produksi</td></tr><% } %>
    </tbody>
  </table>
</div>
