node_modules/
data/*.sqlite
data/sessions.sqlite
.env
.env.*
!.env.example
*.backup

# SQLite runtime artifacts (WAL / shared-memory sidecars)
data/*.sqlite-shm
data/*.sqlite-wal

# Local database dumps — contain real rows and password hashes
tmp/data.sql
tmp/schema.sql
tmp/supabase-import.sql
tmp/pg-schema.sql
tmp/pg-data.sql

# Runtime log (server berjalan via nohup)
tmp/server.log

# Artefak probe/screenshot debug & PID server lokal di tmp/
tmp/probe-*
tmp/*.pid

# Berkas yang diunggah pengguna (foto nota PO, foto material) — data, bukan
# kode. Direktori ini dibuat otomatis saat boot oleh services/photoUpload.js,
# jadi tidak perlu ikut ter-commit. Tanpa ini, setiap foto yang diunggah akan
# muncul sebagai perubahan yang belum di-commit.
uploads/*
!uploads/.gitkeep

# Skrip smoke test & inspeksi DB sekali pakai di tmp/
# (tmp/dump-postgres.js sengaja TIDAK masuk: itu alat backup yang dipakai rutin)
#
# PELAJARAN 2026-09-14: aturan tmp/smoke-*.cjs sempat menyembunyikan tiga skrip
# smoke Vendors yang TIDAK punya duplikat di tests/ — satu-satunya verifikasi UI
# halaman itu, dan karena terabaikan git, sekali terhapus ia hilang permanen.
# Ketiganya sudah dipindah ke tests/. Kalau sebuah skrip masih berguna, ia
# TIDAK boleh tinggal di tmp/ dengan pola yang diabaikan di sini.
tmp/smoke/
tmp/smoke-*.cjs
tmp/check-*.js
tmp/reset-*.js
tmp/*.patch

# Draf pesan commit & body PR — artefak sekali pakai saat menyiapkan commit.
# Sengaja TIDAK meng-ignore seluruh tmp/: skrip di sana sudah terlacak dan
# masih dipakai (tmp/dump-postgres.js untuk backup, tmp/mutate-*.js untuk uji
# mutasi). Meng-ignore direktori utuhnya tidak menghapus berkas yang sudah
# terlacak itu, tetapi akan membuatnya tampak seperti belum ada — dan skrip
# baru di tmp/ akan tersembunyi dari `git status` tanpa disadari.
tmp/commit-msg-*.txt
tmp/pr-*-body.md
tmp/pr-body.md

# Berkas bantuan sekali pakai: diawali underscore, jadi langsung kelihatan
# beda dari skrip yang memang dipakai rutin.

tmp/_*

# Skrip debug sekali pakai (server mainan yang menyajikan dist/index.html).
# Semuanya terlacak sampai 2026-09-14; pola ini mencegah yang serupa menumpuk.
tmp/debug-*.js
tmp/test-*.js

# Frontend build output
frontend/dist/

# Berkas bantuan smoke test, ditulis ke frontend/ karena vite membacanya
# relatif ke sana. Namanya unik per proses (`_smoke-kanban-<acak>.*`) dan
# dibersihkan lewat handler `exit` — tapi handler itu TIDAK jalan kalau
# prosesnya dibunuh paksa (SIGKILL, task manager, pipa PowerShell yang
# ditutup). Tanpa aturan ini, sisa berkasnya muncul sebagai untracked dan
# `git add -A` akan menyapunya masuk commit — persis kesalahan yang paling
# mudah terjadi saat menyiapkan commit setelah menjalankan test.
frontend/_smoke-kanban-*

# Probe sekali pakai juga ditulis ke frontend/ dengan pola `_<nama>.mjs` dan
# hilang setelah exit — aturan `_smoke-kanban-*` di atas tidak menutupnya, dan
# dua probe ini sempat muncul sebagai untracked setelah saya menghapus
# 2026-09-25. Satu baris lagi untuk seluruhnya, bukan satu baris per nama.
frontend/_probe-*

# Local debug artifacts (server logs, curl output, throwaway tests) — jangan commit
*.log
/body.html
/response.html
/headers.txt
/cookies.txt
/test-minimal.js
/test-sidebar.html
/frontend/nul
/.claude.json
/graphify-out/

# Local worktrees (isolated workspaces)
.worktrees/

# Isu/spec lokal (mattpocock-skills) — berisi harga supplier, HPP, skema white label.
# Repo ini publik, jadi jangan sampai ikut ter-commit.
.scratch/
